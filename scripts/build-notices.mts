/**
 * Generates THIRD_PARTY_NOTICES.md at the project root from the cheatsheet collections:
 * for each collection, its NOTICE.md and LICENSE.txt, concatenated verbatim.
 * Idempotent (no timestamps).   Run:  node scripts/build-notices.mts
 */
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';

const root = resolve(import.meta.dirname, '..');
const dir = join(root, 'src', 'content', 'cheatsheets');

const COLLECTIONS = [
  { id: 'pattern-index', title: 'DSA Pattern Recognition — Cheat-Sheet (roxoi/dsa-cheatsheet)' },
  { id: 'patterns-guide', title: 'Complete DSA Patterns Reference Guide (thetorangi/DSA-cheat-sheet)' },
  { id: 'the-only', title: 'The Only Cheatsheets (malharchauhan7/the-only-cheatsheets)' },
];

const norm = (s: string) => s.replace(/\r\n?/g, '\n').replace(/^﻿/, '').replace(/\s+$/, '');

const parts: string[] = [];
parts.push(`# Third-party notices

AlgoFlow's imported cheatsheets (the "Cheatsheets" section of the app) contain material from the open-source projects listed below.
Each project is licensed under the MIT License, whose copyright notice and permission text are reproduced here and with each
collection (\`src/content/cheatsheets/<collection>/NOTICE.md\` and \`LICENSE.txt\`). The notices below are copied verbatim.

AlgoFlow's own code and content (the animations, patterns, Code Tricks, Edge Cases and the rest of the application) are separate
work. Their license status is independent of the licenses below, which apply only to the third-party material named in each section.

This file is generated by \`node scripts/build-notices.mts\`; do not edit it by hand.`);

const missing: string[] = [];
for (const c of COLLECTIONS) {
  const noticePath = join(dir, c.id, 'NOTICE.md');
  const licensePath = join(dir, c.id, 'LICENSE.txt');
  const notice = existsSync(noticePath) ? norm(readFileSync(noticePath, 'utf8')) : '';
  const license = existsSync(licensePath) ? norm(readFileSync(licensePath, 'utf8')) : '';
  if (!notice) missing.push(`${c.id}/NOTICE.md`);
  if (!license) missing.push(`${c.id}/LICENSE.txt`);
  if (!notice && !license) continue;
  parts.push(`---\n\n## ${c.title}`);
  if (notice) parts.push(`### Notice\n\n${notice}`);
  if (license) parts.push(`### License text\n\n\`\`\`text\n${license}\n\`\`\``);
}

const out = `${parts.join('\n\n')}\n`;
const target = join(root, 'THIRD_PARTY_NOTICES.md');
const before = existsSync(target) ? readFileSync(target, 'utf8') : null;
if (before !== out) writeFileSync(target, out);
console.log(`${before === out ? 'unchanged' : 'wrote'} THIRD_PARTY_NOTICES.md (${out.length} chars)`);
if (missing.length) {
  console.log(`MISSING (not yet written by the importers): ${missing.join(', ')}`);
  process.exitCode = 1;
}
