/**
 * Regenerates src/problems/manifest.ts — the light slug -> lazy-import index the browser uses.
 *   node scripts/gen-manifest.mts            write the file
 *   node scripts/gen-manifest.mts --check    exit 1 when the committed file is out of date (used by npm run check)
 *
 * Run it after adding a problem (a new slug in any src/problems/groups/*.ts file).
 * It imports every problem module in Node, so each ALL_PROBLEMS entry is located by object identity
 * (a file may export one problem or an array of problems).
 */
import { readdirSync, readFileSync, writeFileSync, existsSync } from 'node:fs';
import { join, relative, sep } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { ALL_PROBLEMS } from '../src/problems/registry.ts';

const root = fileURLToPath(new URL('../src/problems/', import.meta.url));
const SKIP = new Set(['registry.ts', 'manifest.ts', 'lazy.ts', 'useProblem.ts']);

function walk(dir: string): string[] {
  const out: string[] = [];
  for (const d of readdirSync(dir, { withFileTypes: true })) {
    const p = join(dir, d.name);
    if (d.isDirectory()) { if (d.name !== 'groups') out.push(...walk(p)); }
    else if (d.name.endsWith('.ts') && !SKIP.has(d.name)) out.push(p);
  }
  return out.sort();
}

const isProblem = (v: unknown): boolean =>
  !!v && typeof v === 'object' && typeof (v as { slug?: unknown }).slug === 'string' && typeof (v as { buildSteps?: unknown }).buildSteps === 'function';

const files: string[] = [];
const where = new Map<unknown, { file: number; name: string }>();
for (const f of walk(root)) {
  const mod = (await import(pathToFileURL(f).href)) as Record<string, unknown>;
  const rel = './' + relative(root, f).split(sep).join('/');
  let idx = -1;
  for (const [name, v] of Object.entries(mod)) {
    const items = Array.isArray(v) ? v : [v];
    for (const it of items) {
      if (!isProblem(it) || where.has(it)) continue;
      if (idx < 0) { idx = files.length; files.push(rel); }
      where.set(it, { file: idx, name });
    }
  }
}

const lines: string[] = [];
const missing: string[] = [];
for (const p of ALL_PROBLEMS) {
  const w = where.get(p);
  if (!w) { missing.push(p.slug); continue; }
  lines.push(`  ${JSON.stringify(p.slug)}: [${w.file}, ${JSON.stringify(w.name)}],`);
}
if (missing.length) {
  console.error(`could not locate a module for: ${missing.join(', ')}`);
  process.exit(1);
}
lines.sort();

const text = `// GENERATED by scripts/gen-manifest.mts — do not edit. Regenerate with: node scripts/gen-manifest.mts
// Light slug -> lazy-import index: the browser loads a problem's animation code only when it is opened.
// Node scripts keep using the eager list in ./registry.ts.

/** One dynamic import per module (several problems may live in one file). */
export const MODULES: (() => Promise<Record<string, unknown>>)[] = [
${files.map((f) => `  () => import(${JSON.stringify(f)}),`).join('\n')}
];

/** slug -> [index into MODULES, export name]; the export is a problem or an array of problems. */
export const MANIFEST: Record<string, [number, string]> = {
${lines.join('\n')}
};
`;

const target = join(root, 'manifest.ts');
if (process.argv.includes('--check')) {
  const cur = existsSync(target) ? readFileSync(target, 'utf8') : '';
  if (cur.replace(/\r\n/g, '\n') !== text) {
    console.error('src/problems/manifest.ts is out of date — run: node scripts/gen-manifest.mts');
    process.exit(1);
  }
  console.log(`manifest up to date (${lines.length} problems, ${files.length} modules)`);
} else {
  writeFileSync(target, text);
  console.log(`wrote src/problems/manifest.ts (${lines.length} problems, ${files.length} modules)`);
}
